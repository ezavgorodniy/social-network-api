# Copy to .env and adjust. .env is git-ignored and must never be committed.

# --- Application ---
# Port the HTTP server listens on.
PORT=3000
# Nest environment: development | production | test
NODE_ENV=development

# --- Database ---
# PostgreSQL connection string used by Prisma. Matches docker-compose.yml.
DATABASE_URL="postgresql://app:app@localhost:5432/social_network?schema=public"

# --- Platform authentication (pass-through / BYOT) ---
# NOTE: platform access tokens are NOT configured here. Callers supply the token
# per request via the `X-Platform-Token` header (see docs/adrs/0007). The server
# never stores or logs it.
#
# The ONLY exception is the manual live smoke test (scripts/live-smoke), which may
# read a token from the environment as a fallback when --token is omitted. Leave
# this unset for normal development; never commit a real token.
# FACEBOOK_ACCESS_TOKEN=
